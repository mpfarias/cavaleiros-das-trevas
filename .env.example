# Origens da plataforma RedRAM autorizadas a conversar com o jogo (postMessage)
VITE_REDRAM_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sincronizar progresso com a conta RedRAM (grava no banco).
# Mantenha false enquanto estiver testando o fluxo do jogo localmente.
VITE_REDRAM_SYNC=false
